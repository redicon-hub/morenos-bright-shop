{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "damoreno-mcp",
      "version": "0.1.0",
      "title": "DA MORENO"
    },
    "tools": [
      {
        "name": "list_categories",
        "title": "List categories",
        "description": "List DA MORENO master categories with their sub-sections and short taglines. Useful to guide product browsing.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_products",
        "title": "List products",
        "description": "List DA MORENO products in the online catalog, optionally filtered by category. Returns name, slug, price (CHF), category and a short description for each product.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "description": "Optional category filter. Use 'Tutti' or omit for all categories.",
              "type": "string",
              "enum": [
                "Tutti",
                "Home Decor",
                "Arredamento",
                "Profumazione",
                "Casalinghi",
                "Party",
                "Kids",
                "Pensa Crea Regala",
                "Animali",
                "Stagionale"
              ]
            },
            "limit": {
              "description": "Maximum items to return (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "search_products",
        "title": "Search products",
        "description": "Full-text search across DA MORENO products by name, description and features. Returns matching products with slug, name, price and category.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Search text (Italian). Matched against name, description and features."
            },
            "limit": {
              "description": "Maximum results to return (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_product",
        "title": "Get product details",
        "description": "Get full details for a single DA MORENO product by its slug (as returned by list_products or search_products).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Product slug, e.g. 'vaso-decorativo-ceramica'."
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_stores",
        "title": "List DA MORENO stores",
        "description": "List the 5 DA MORENO physical stores in Ticino (Switzerland) with address, ZIP, phone and opening hours.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
